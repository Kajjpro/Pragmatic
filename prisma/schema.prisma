generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  STAFF
}

enum Vote {
  SUPPORT
  OPPOSE
  NEUTRAL
}

enum CommentSource {
  WEB
  PAPER
}

enum ClusterStatus {
  OPEN
  ANSWERED
}

enum ProjectSource {
  LAWFORUM
  UPLOAD
}

enum Stage {
  DISCUSS_DECISION
  FIRST_READING
  FINAL_READING
  FINAL_APPROVAL
}

enum ChangeType {
  ADDED
  REMOVED
  CHANGED
  UNCHANGED
}

enum Reflection {
  PENDING
  REFLECTED
  NOT_REFLECTED
}

enum FilterStatus {
  RELEVANT
  OFF_TOPIC
  ABUSIVE
  DUPLICATE
}

// Хэрэглэгчийн төрөл — карт хэнд зориулсныг заана. ALL = бүгдэд
enum Persona {
  STUDENT
  DRIVER
  WORKER
  PARENT
  ALL
}

// DRAFT = нийтлээгүй, OPEN = таамаг авч байна, REVEALED = дүн гарсан
enum VoteEventStatus {
  DRAFT
  OPEN
  REVEALED
}

enum BadgeType {
  STREAK_7
  FIRST_PREDICTION
  LAW_CHANGER
}

model User {
  id              String         @id @default(cuid())
  clerkId         String         @unique
  name            String?
  email           String?
  role            Role           @default(CITIZEN)
  committee       String?
  persona         Persona?
  points          Int            @default(0)
  streak          Int            @default(0)
  lastActiveDate  DateTime?      @db.Date
  comments        Comment[]
  approvedReplies Reply[]        @relation("ApprovedBy")
  notifications   Notification[]
  cardViews       CardView[]
  quizAnswers     QuizAnswer[]
  predictions     Prediction[]
  badges          Badge[]
  createdAt       DateTime       @default(now())
}

model Project {
  id             String        @id @default(cuid())
  lawforumId     Int?          @unique
  title          String
  description    String?
  projectNumber  String?
  typeTitle      String?
  categoryTitle  String?
  status         Int?
  lawforumStage  Int?
  stage          Stage         @default(DISCUSS_DECISION)
  slugUrl        String?
  publishedAt    DateTime?
  allowComments  Boolean       @default(true)
  lawforumStats  Json?
  source         ProjectSource @default(LAWFORUM)
  currentLawText String?
  amendmentText  String?
  reasonText     String?
  agendaCode     String?       @unique
  clauses        Clause[]
  cards          Card[]
  voteEvents     VoteEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Clause {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String
  heading     String?
  oldText     String?
  newText     String?
  changeType  ChangeType @default(UNCHANGED)
  diff        Json       @default("[]")
  sourceQuote String?
  applyError  Boolean    @default(false)
  what        String?
  why         String?
  who         String?
  approved    Boolean    @default(false)
  plainText   String?
  order       Int
  comments    Comment[]
  clusters    Cluster[]

  @@index([projectId])
}

model Cluster {
  id         String        @id @default(cuid())
  clauseId   String
  clause     Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  label      String
  summary    String?
  status     ClusterStatus @default(OPEN)
  replyDraft String?
  replyText  String?
  reflection Reflection    @default(PENDING)
  repliedAt  DateTime?
  comments   Comment[]
  reply      Reply?
  createdAt  DateTime      @default(now())

  @@index([clauseId])
}

model Comment {
  id             String        @id @default(cuid())
  clauseId       String
  clause         Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  vote           Vote          @default(NEUTRAL)
  body           String
  source         CommentSource @default(WEB)
  petitionerName String?
  paperImageUrl  String?
  clusterId      String?
  cluster        Cluster?      @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  suspicious     Boolean       @default(false)
  filterStatus   FilterStatus?
  filterReason   String?
  restored       Boolean       @default(false)
  relevantPoints Boolean       @default(false)
  badges         Badge[]
  createdAt      DateTime      @default(now())

  @@index([clauseId])
  @@index([clusterId])
}

model Reply {
  id            String         @id @default(cuid())
  clusterId     String         @unique
  cluster       Cluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  aiDraft       String?
  finalText     String?
  approvedById  String?
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String    @default("")
  link      String?
  replyId   String?
  reply     Reply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, replyId])
  @@index([userId, createdAt])
}

// ───────────── Хариу v2: карт, асуулт, таамаг, тэмдэг ─────────────

// 60 секундын хуулийн карт. slug нь seed-ийг дахин ажиллуулахад ижил картыг олоход хэрэгтэй.
model Card {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  hook        String
  body        String
  personas    Persona[]
  order       Int            @default(0)
  publishedAt DateTime       @default(now())
  sourceUrl   String?
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  questions   QuizQuestion[]
  views       CardView[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([order, publishedAt])
}

model QuizQuestion {
  id           String       @id @default(cuid())
  cardId       String
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  order        Int          @default(0)
  question     String
  options      String[]
  correctIndex Int
  explanation  String
  answers      QuizAnswer[]

  @@index([cardId])
}

// Нэг хэрэглэгч нэг картыг өдөрт нэг л удаа "үзсэн" болно (+1 оноо)
model CardView {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, cardId, day])
  @@index([cardId])
}

// Зөвхөн эхний хариулт хадгалагдана — оноо зөвхөн эхний оролдлогод
model QuizAnswer {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIndex   Int
  correct       Boolean
  pointsAwarded Int          @default(0)
  createdAt     DateTime     @default(now())

  @@unique([userId, questionId])
  @@index([questionId])
}

// УИХ-ын санал хураалт — иргэд үр дүнг таамаглана.
// isReplay = санал хураалт аль хэдийн болсон; жинхэнэ тоо hidden* талбарт нуугдана, reveal хийхэд actual* руу шилжинэ.
model VoteEvent {
  id            String          @id @default(cuid())
  agendaCode    String          @unique
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  hook          String
  status        VoteEventStatus @default(DRAFT)
  isReplay      Boolean         @default(false)
  voteDate      DateTime?
  hiddenSupport Int?
  hiddenOppose  Int?
  hiddenTotal   Int?
  actualSupport Int?
  actualOppose  Int?
  actualTotal   Int?
  passed        Boolean?
  revealedAt    DateTime?
  predictions   Prediction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

// Нэг хэрэглэгч нэг санал хураалтад нэг л таамаг. pointsAwarded = null бол дүн гараагүй.
model Prediction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteEventId   String
  voteEvent     VoteEvent @relation(fields: [voteEventId], references: [id], onDelete: Cascade)
  willPass      Boolean
  supportGuess  Int
  pointsAwarded Int?
  createdAt     DateTime  @default(now())

  @@unique([userId, voteEventId])
  @@index([voteEventId])
}

// key нь тэмдэг давхардахгүй байх баталгаа:
//   "STREAK_7:<userId>", "FIRST_PREDICTION:<userId>", "LAW_CHANGER:<commentId>"
// lawTitle / clauseNumber нь олгох үеийн хуулбар — хуваалцах хуудас join хийлгүй ажиллана.
model Badge {
  id           String    @id @default(cuid())
  key          String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BadgeType
  commentId    String?
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  lawTitle     String?
  clauseNumber String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}
