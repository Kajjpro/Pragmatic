// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  STAFF
}

enum Vote {
  SUPPORT
  OPPOSE
  NEUTRAL
}

enum CommentSource {
  WEB
  PAPER
}

enum ClusterStatus {
  OPEN
  ANSWERED
}

enum ProjectSource {
  LAWFORUM
  UPLOAD
}

// ── AI урсгалд нэмсэн төрлүүд (CLAUDE.md "Shared types") ──

// Хэлэлцэх эсэх | Анхны хэлэлцүүлэг | Эцсийн хэлэлцүүлэг | Эцэслэн батлах
enum BillStage {
  DISCUSS_DECISION
  FIRST_READING
  FINAL_READING
  FINAL_APPROVAL
}

// Заалт нэмсэн | хассан | өөрчилсөн | өөрчлөгдөөгүй
enum ChangeType {
  ADDED
  REMOVED
  CHANGED
  UNCHANGED
}

// Хамааралтай | Сэдвээс гадуур | Утгагүй/доромжилсон | Давхардсан
enum FilterStatus {
  RELEVANT
  OFF_TOPIC
  ABUSIVE
  DUPLICATE
}

// Хүлээгдэж буй | Тусгасан | Тусгаагүй
enum Reflection {
  PENDING
  REFLECTED
  NOT_REFLECTED
}

model User {
  id              String         @id @default(cuid())
  clerkId         String         @unique
  name            String?
  email           String?
  role            Role           @default(CITIZEN)
  committee       String? 
  comments        Comment[]
  approvedReplies Reply[]        @relation("ApprovedBy")
  notifications   Notification[]
  createdAt       DateTime       @default(now())
}

model Project {
  id            String        @id @default(cuid())
  lawforumId    Int?          @unique
  title         String
  description   String?
  projectNumber String?
  typeTitle     String?
  categoryTitle String?
  status        Int?
  stage         Int?
  slugUrl       String?
  publishedAt   DateTime?
  allowComments Boolean       @default(true)
  lawforumStats Json? 
  source        ProjectSource @default(LAWFORUM)
  // Ажилтан оруулсан хуулийн төсөл (AI урсгал)
  billStage      BillStage?
  currentLawText String? // одоо мөрдөж буй хууль
  amendmentText  String? // нэмэлт, өөрчлөлтийн төсөл
  reasonText     String? // төслийн үндэслэл, танилцуулга
  clauses       Clause[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}


model Clause {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       String 
  heading      String?
  originalText String
  plainText    String?
  order        Int
  // Харьцуулалт + AI тайлбар
  oldText      String? // хуучин заалт (нэмсэн заалтад null)
  newText      String? // шинэ заалт (хассан заалтад null)
  changeType   ChangeType @default(UNCHANGED)
  diff         Json? // үгийн түвшний ялгаа: [{ value, added?, removed? }]
  sourceQuote  String? // төслөөс үг үсгээр нь авсан ишлэл
  what         String?
  why          String?
  who          String?
  approved     Boolean    @default(false)
  applyError   String? // өөрчлөлтийг хэрэгжүүлж чадаагүй бол шалтгаан
  comments     Comment[]
  clusters     Cluster[]

  @@index([projectId])
}

model Cluster {
  id        String        @id @default(cuid())
  clauseId  String
  clause    Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  label     String 
  summary   String?
  status    ClusterStatus @default(OPEN)
  comments  Comment[]
  reply     Reply?
  createdAt DateTime      @default(now())

  @@index([clauseId])
}

model Comment {
  id             String        @id @default(cuid())
  clauseId       String
  clause         Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  userId         String? 
  user           User?         @relation(fields: [userId], references: [id])
  vote           Vote          @default(NEUTRAL)
  body           String
  source         CommentSource @default(WEB)
  petitionerName String? 
  paperImageUrl  String?
  clusterId      String?
  cluster        Cluster?      @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  suspicious     Boolean       @default(false)
  // AI шүүлт (юу ч устгахгүй, зөвхөн шошго)
  filterStatus   FilterStatus  @default(RELEVANT)
  filterReason   String?
  filteredAt     DateTime? // null = хараахан шүүгээгүй шинэ санал
  createdAt      DateTime      @default(now())

  @@index([clauseId])
  @@index([clusterId])
}

model Reply {
  id            String         @id @default(cuid())
  clusterId     String         @unique
  cluster       Cluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  aiDraft       String?
  finalText     String?
  reflection    Reflection     @default(PENDING) // Тусгасан / Тусгаагүй
  approvedById  String?
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   String
  reply     Reply     @relation(fields: [replyId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, replyId])
}
