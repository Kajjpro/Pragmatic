generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  STAFF
}

enum Vote {
  SUPPORT
  OPPOSE
  NEUTRAL
}

enum CommentSource {
  WEB
  PAPER
}

enum ClusterStatus {
  OPEN
  ANSWERED
}

enum ProjectSource {
  LAWFORUM
  UPLOAD
}

enum Stage {
  DISCUSS_DECISION
  FIRST_READING
  FINAL_READING
  FINAL_APPROVAL
}

enum ChangeType {
  ADDED
  REMOVED
  CHANGED
  UNCHANGED
}

enum Reflection {
  PENDING
  REFLECTED
  NOT_REFLECTED
}

enum FilterStatus {
  RELEVANT
  OFF_TOPIC
  ABUSIVE
  DUPLICATE
}

// Хэрэглэгчийн төрөл — карт хэнд зориулсныг заана. ALL = бүгдэд
enum Persona {
  STUDENT
  DRIVER
  WORKER
  PARENT
  ALL
}

// OPEN = таамаг авч байна, REVEALED = дүн гарсан
enum VoteEventStatus {
  OPEN
  REVEALED
}

// BILL = бүтэн төсөл, CHANGE = нэг заалтын өөрчлөлт
enum CardKind {
  BILL
  CHANGE
}

enum BadgeType {
  STREAK_7
  FIRST_PREDICTION
  LAW_CHANGER
}

model User {
  id              String         @id @default(cuid())
  clerkId         String         @unique
  name            String?
  email           String?
  role            Role           @default(CITIZEN)
  committee       String?
  persona         Persona        @default(ALL)
  points          Int            @default(0)
  streak          Int            @default(0)
  lastActiveDate  DateTime?      @db.Date
  comments        Comment[]
  approvedReplies Reply[]        @relation("ApprovedBy")
  notifications   Notification[]
  cardViews       CardView[]
  quizAnswers     QuizAnswer[]
  predictions     Prediction[]
  badges          Badge[]
  createdAt       DateTime       @default(now())
}

model Project {
  id             String        @id @default(cuid())
  lawforumId     Int?          @unique
  title          String
  description    String?
  projectNumber  String?
  typeTitle      String?
  categoryTitle  String?
  status         Int?
  lawforumStage  Int?
  stage          Stage         @default(DISCUSS_DECISION)
  slugUrl        String?
  publishedAt    DateTime?
  allowComments  Boolean       @default(true)
  lawforumStats  Json?
  source         ProjectSource @default(LAWFORUM)
  currentLawText String?
  amendmentText  String?
  reasonText     String?
  agendaCode     String?       @unique
  clauses        Clause[]
  cards          Card[]
  voteEvents     VoteEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Clause {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String
  heading     String?
  oldText     String?
  newText     String?
  changeType  ChangeType @default(UNCHANGED)
  diff        Json       @default("[]")
  sourceQuote String?
  applyError  Boolean    @default(false)
  what        String?
  why         String?
  who         String?
  approved    Boolean    @default(false)
  plainText   String?
  order       Int
  comments    Comment[]
  clusters    Cluster[]
  cards       Card[]

  @@index([projectId])
}

model Cluster {
  id         String        @id @default(cuid())
  clauseId   String
  clause     Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  label      String
  summary    String?
  status     ClusterStatus @default(OPEN)
  replyDraft String?
  replyText  String?
  reflection Reflection    @default(PENDING)
  repliedAt  DateTime?
  comments   Comment[]
  reply      Reply?
  createdAt  DateTime      @default(now())

  @@index([clauseId])
}

model Comment {
  id             String        @id @default(cuid())
  clauseId       String
  clause         Clause        @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  vote           Vote          @default(NEUTRAL)
  body           String
  source         CommentSource @default(WEB)
  petitionerName String?
  paperImageUrl  String?
  clusterId      String?
  cluster        Cluster?      @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  suspicious     Boolean       @default(false)
  filterStatus   FilterStatus?
  filterReason   String?
  restored       Boolean       @default(false)
  relevantPoints Boolean       @default(false)
  badges         Badge[]
  createdAt      DateTime      @default(now())

  @@index([clauseId])
  @@index([clusterId])
}

model Reply {
  id            String         @id @default(cuid())
  clusterId     String         @unique
  cluster       Cluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  aiDraft       String?
  finalText     String?
  approvedById  String?
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String    @default("")
  link      String?
  replyId   String?
  reply     Reply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, replyId])
  @@index([userId, createdAt])
}

// ───────────── Хариу v2: карт, асуулт, таамаг, тэмдэг ─────────────

// 60 секундын хуулийн карт. Нэг карт = нэг төсөл (BILL) эсвэл нэг өөрчлөлт (CHANGE).
// seed нь картын id-г өөрөө өгдөг (жишээ нь "card-overtime") тул дахин ажиллуулахад давхардахгүй.
model Card {
  id          String         @id @default(cuid())
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clauseId    String?
  clause      Clause?        @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  kind        CardKind
  emoji       String
  hook        String // ≤ 60 тэмдэгт
  before      String? // "Одоо"
  after       String? // "Болох нь"
  youMeaning  String // "Чамд юу гэсэн үг вэ"
  sourceQuote String? // төслөөс яг хуулсан өгүүлбэр — BILL картын «Ийм болно»
  personas    Persona[]
  sourceUrl   String
  order       Int            @default(0)
  publishedAt DateTime       @default(now())
  questions   QuizQuestion[]
  views       CardView[]

  @@index([order, publishedAt])
}

model QuizQuestion {
  id           String       @id @default(cuid())
  cardId       String
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  order        Int          @default(0)
  question     String
  options      Json // string[] — 3–4 сонголт
  correctIndex Int
  explanation  String
  answers      QuizAnswer[]

  @@index([cardId])
}

// Нэг хэрэглэгч нэг картыг өдөрт нэг л удаа "үзсэн" болно (+1 оноо)
model CardView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, cardId, day])
  @@index([cardId])
}

// Зөвхөн эхний хариулт хадгалагдана — оноо зөвхөн эхний оролдлогод
model QuizAnswer {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIndex Int
  correct     Boolean
  createdAt   DateTime     @default(now())

  @@unique([userId, questionId])
  @@index([questionId])
}

// УИХ-ын санал хураалт — иргэд үр дүнг таамаглана.
// isReplay = санал хураалт аль хэдийн болсон; жинхэнэ тоо hidden* талбарт нуугдана, reveal хийхэд actual* руу шилжинэ.
model VoteEvent {
  id            String          @id @default(cuid())
  agendaCode    String          @unique
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  hook          String
  status        VoteEventStatus @default(OPEN)
  isReplay      Boolean         @default(false)
  closesAt      DateTime?
  hiddenSupport Int?
  hiddenOppose  Int?
  hiddenTotal   Int?
  actualSupport Int?
  actualOppose  Int?
  actualTotal   Int?
  passed        Boolean?
  revealedAt    DateTime?
  predictions   Prediction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

// Нэг хэрэглэгч нэг санал хураалтад нэг л таамаг. points нь дүн гарахад (reveal) бичигдэнэ.
model Prediction {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteEventId  String
  voteEvent    VoteEvent @relation(fields: [voteEventId], references: [id], onDelete: Cascade)
  willPass     Boolean
  supportGuess Int
  points       Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([userId, voteEventId])
  @@index([voteEventId])
}

// key нь тэмдэг давхардахгүй байх баталгаа:
//   "STREAK_7:<userId>", "FIRST_PREDICTION:<userId>", "LAW_CHANGER:<submissionId>"
// submissionId = иргэний санал (Comment). Хууль, заалтын нэрийг тэндээс уншина.
model Badge {
  id           String    @id @default(cuid())
  key          String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BadgeType
  submissionId String?
  submission   Comment?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ───────────── Эх сурвалжийн хуулбар: УИХ-ын ParliamentAPI, LawForum (npm run vote -- sync) ─────────────
// Гадны API-ийн өгөгдлийг өөрчлөхгүйгээр хадгална. /api/parliament/*, /api/drafts эндээс уншина (lib/parliament-data.ts).
// Манай бүтээгдэхүүний Project, VoteEvent-ээс тусдаа — эдгээр нь зөвхөн эх сурвалжийн хуулбар.

// Хэлэлцэх асуудал (getAgendaList). finalVoteId = эцсийн (батлах) санал хураалт — lib/parliament.ts finalReadingVote.
model ParliamentAgenda {
  agendaCode  String           @id // 11 оронтой
  title       String
  voteCount   Int              @default(0)
  lastVotedAt DateTime?
  finalVoteId String? // ParliamentVote.customId. Олдоогүй бол null — таамаглахгүй
  votes       ParliamentVote[]
  syncedAt    DateTime         @updatedAt

  @@index([lastVotedAt])
}

// Санал хураалт (getAgendaVoteList). Зөвхөн тоо — гишүүн бүрийн саналыг хадгалахгүй (CLAUDE.md: төвийг сахих).
// API нэг санал хураалтыг хэд хэдэн асуудалд буцаадаг тул (agendaCode, customId) хосоороо давтагдашгүй.
model ParliamentVote {
  id         String           @id @default(cuid())
  agendaCode String
  agenda     ParliamentAgenda @relation(fields: [agendaCode], references: [agendaCode], onDelete: Cascade)
  customId   String // "549_202512310038117" = хуралдааны id + санал хураалтын дугаар
  meetingId  Int?
  name       String // санал хураалтын асуулт
  voteType   String // "Хэлэлцэх эсэх", "Эцэслэн батлах", ...
  support    Int // zovshooron — зөвшөөрсөн
  oppose     Int // tatgalzsan — татгалзсан
  total      Int // niit
  present    Int? // irts — ирц
  votedAt    DateTime?
  syncedAt   DateTime         @updatedAt

  @@unique([agendaCode, customId])
  @@index([meetingId])
}

// Хуралдаан (getMeetings)
model ParliamentMeeting {
  id          Int       @id // ParliamentAPI-ийн хуралдааны id
  title       String
  description String?
  startsAt    DateTime? // товлосон цаг
  openedAt    DateTime? // нээгдсэн цаг
  endedAt     DateTime?
  syncedAt    DateTime  @updatedAt

  @@index([startsAt])
}

// УИХ-ын гишүүд (Service getMembers). Энэ эрхээр API хоосон жагсаалт буцаадаг — ирвэл хадгална.
model ParliamentMember {
  key      String   @id // имэйл, id эсвэл нэр
  name     String?
  email    String?
  data     Json // API-ийн анхны мөр
  syncedAt DateTime @updatedAt
}

// LawForum-ын БҮХ хуулийн төсөл (/api/v1/projects), идэвхгүй нь ч.
// Project = манай бүтээгдэхүүний төсөл (/bills: харьцуулалт, санал, карт); LawDraft = эх сурвалжийн жагсаалтын хуулбар.
model LawDraft {
  id            Int       @id // LawForum-ын төслийн id
  title         String
  projectNumber String?
  typeId        Int?
  typeTitle     String?
  categoryId    Int?
  categoryTitle String?
  status        Int?
  stage         Int?
  isActive      Boolean   @default(false)
  publishedAt   DateTime?
  syncedAt      DateTime  @updatedAt

  @@index([publishedAt])
}
